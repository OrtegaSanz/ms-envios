<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.nttdata</groupId>
    <artifactId>ms-envios</artifactId>
    <version>1.0.0</version>
    <name>ms-envios</name>
    <description>RutaExpress - Taller de Config Maps</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- SnakeYAML llega con spring-boot-starter: el Validador lo usa para leer los YAML. -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.3.12</version>
                <configuration>
                    <mainClass>com.nttdata.envios.MsEnviosApplication</mainClass>
                    <image>
                        <name>ms-envios:1.0.0</name>
                    </image>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
